# Public (safe to expose, used by browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-api-key

# ⚠️ Google Gemini API key for Vision OCR (image extraction from PDFs,
# scanned documents, certificates with colored backgrounds, etc.).
# Get a free-tier key from https://aistudio.google.com/apikey
# Used by src/lib/ai/gemini-pool.ts. If not set, the system falls back
# to local sharp + tesseract.js OCR (slower but works offline).
GEMINI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DocuMind AI

# Rate limiting (optional — defaults to in-memory if blank)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability (optional — Batches 6+)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Stripe (Batch 8)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=